# Copy to .env.local for local dev, and set both in Vercel → Project → Settings → Environment
# Variables (Production + Preview). The dashboard refuses to authenticate anyone if either is
# missing — it fails closed, never open.

# What you type on the login screen.
DASHBOARD_PASSWORD=change-me

# The session cookie's value. Any long random string. Rotating it signs every device out.
#   openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# --- Writing from the dashboard (the /log page) ----------------------------------------------
# Only needed for the Log tab. Without these the forms render but refuse to save, with a banner
# saying so — they never pretend to have written something.
#
# The repo IS the database: Vercel's filesystem is ephemeral, so a logged set has to land in git
# or it does not exist, and landing in git is also what rebuilds the dashboard.

# owner/name of this repository.
GITHUB_REPO=owner/coach

# Fine-grained personal access token, scoped to THIS repo only, with:
#   Repository permissions → Contents: Read and write
# Nothing else. This token can rewrite the chart, so give it no wider access than that.
GITHUB_TOKEN=github_pat_...
